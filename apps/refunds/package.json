{
  "name": "refunds",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently --names server,ui --prefix-colors blue,magenta \"npm run dev:server\" \"npm run dev:ui\"",
    "dev:server": "tsx server/index.ts",
    "dev:ui": "vite --config ui/vite.config.ts",
    "build": "vite build --config ui/vite.config.ts"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "concurrently": "^9.1.2",
    "vite": "^6.4.3"
  }
}
