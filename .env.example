# Copy to .env for local work. Both roles live on the same local Postgres; the
# scaffold's guarantees depend on the app NEVER connecting as scaffold_owner.
# Local passwords are throwaway; there is no real data anywhere in this repo.

# used by: npm run migrate
DATABASE_URL_OWNER=postgres://scaffold_owner:scaffold_owner@localhost:5432/tools

# used by: npm test, npm run seed, npm run dev, npm run governance-report
DATABASE_URL=postgres://app_role:app_role@localhost:5432/tools

NODE_ENV=development
