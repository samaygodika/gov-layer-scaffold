{
  "name": "internal-tools-scaffold",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "workspaces": [
    "scaffold",
    "apps/*"
  ],
  "scripts": {
    "migrate": "tsx scaffold/src/migrate.ts",
    "seed": "tsx scaffold/src/seed.ts",
    "test": "vitest run --reporter=default --reporter=junit --outputFile=reports/junit/session-1a.xml",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "@types/pg": "^8.11.10",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  },
  "dependencies": {
    "dotenv": "^16.4.7",
    "pg": "^8.13.1"
  }
}
